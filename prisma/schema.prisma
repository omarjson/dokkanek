generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         String   @default("CASHIER")
  active       Boolean  @default(true)
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  cashierSales Sale[]   @relation("CashierSales")
  createdAt    DateTime @default(now())
}

model Branch {
  id         String      @id @default(cuid())
  name       String
  city       String      @default("")
  phone      String      @default("")
  users      User[]
  warehouses Warehouse[]
  sales      Sale[]
}

model Warehouse {
  id       String    @id @default(cuid())
  name     String
  branchId String?
  branch   Branch?   @relation(fields: [branchId], references: [id])
  products Product[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id          String       @id @default(cuid())
  sku         String       @unique
  name        String
  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id])
  costPrice   Float        @default(0)
  salePrice   Float        @default(0)
  quantity    Float        @default(0)
  warehouseId String?
  warehouse   Warehouse?   @relation(fields: [warehouseId], references: [id])
  barcode     String       @default("")
  isFavorite  Boolean      @default(false)
  minQuantity Float        @default(5)
  active      Boolean      @default(true)
  legacyNo    String       @default("")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  saleItems   SaleItem[]
  stockMoves  StockMove[]
  returns     Return[]
  damages     Damage[]
  purchases   PurchaseItem[]
  stocktakes  StocktakeItem[]
}

model Customer {
  id          String    @id @default(cuid())
  name        String
  phone       String    @default("")
  address     String    @default("")
  creditLimit Float     @default(0)
  balance     Float     @default(0)
  sales       Sale[]
  payments    Payment[]
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  phone     String     @default("")
  address   String     @default("")
  balance   Float      @default(0)
  purchases Purchase[]
}

model Purchase {
  id         String         @id @default(cuid())
  no         String         @unique
  supplierId String?
  supplier   Supplier?      @relation(fields: [supplierId], references: [id])
  branchId   String?
  total      Float          @default(0)
  paid       Float          @default(0)
  status     String         @default("COMPLETED")
  date       DateTime       @default(now())
  items      PurchaseItem[]
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  qty        Float
  price      Float
}

model Sale {
  id          String       @id @default(cuid())
  no          String       @unique
  branchId    String?
  branch      Branch?      @relation(fields: [branchId], references: [id])
  customerId  String?
  customer    Customer?    @relation(fields: [customerId], references: [id])
  cashierId   String?
  cashier     User?        @relation("CashierSales", fields: [cashierId], references: [id])
  status      String       @default("COMPLETED")
  payMethod   String       @default("CASH")
  subtotal    Float        @default(0)
  discount    Float        @default(0)
  total       Float        @default(0)
  paid        Float        @default(0)
  date        DateTime     @default(now())
  items       SaleItem[]
  payments    Payment[]
  returns     Return[]
  courierTask CourierTask?
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Float
  price     Float
}

model Payment {
  id         String    @id @default(cuid())
  saleId     String?
  sale       Sale?     @relation(fields: [saleId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  amount     Float
  method     String    @default("CASH")
  date       DateTime  @default(now())
  note       String    @default("")
}

model Expense {
  id       String   @id @default(cuid())
  branchId String?
  title    String
  amount   Float
  date     DateTime @default(now())
  note     String   @default("")
}

model CashShift {
  id       String    @id @default(cuid())
  branchId String?
  userId   String?
  opening  Float     @default(0)
  closing  Float?
  openedAt DateTime  @default(now())
  closedAt DateTime?
  status   String    @default("OPEN")
}

model StockMove {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  qty       Float
  type      String
  note      String   @default("")
  date      DateTime @default(now())
  userId    String?
}

model Return {
  id        String   @id @default(cuid())
  saleId    String?
  sale      Sale?    @relation(fields: [saleId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  qty       Float
  reason    String   @default("")
  date      DateTime @default(now())
}

model Damage {
  id        String   @id @default(cuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  qty       Float
  reason    String   @default("")
  date      DateTime @default(now())
}

model CourierTask {
  id          String   @id @default(cuid())
  saleId      String   @unique
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  courierName String   @default("")
  status      String   @default("PENDING")
  codAmount   Float    @default(0)
  collected   Float    @default(0)
  date        DateTime @default(now())
}

model Employee {
  id             String       @id @default(cuid())
  name           String
  phone          String       @default("")
  title          String       @default("")
  salary         Float        @default(0)
  commissionRate Float        @default(0)
  active         Boolean      @default(true)
  attendances    Attendance[]
}

model Attendance {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime  @default(now())
  checkIn    DateTime?
  checkOut   DateTime?
  minutes    Int       @default(0)
}

model MaintenanceTicket {
  id            String       @id @default(cuid())
  no            String       @unique
  customerName  String
  customerPhone String       @default("")
  device        String
  issue         String       @default("")
  status        String       @default("RECEIVED")
  technician    String       @default("")
  cost          Float        @default(0)
  paid          Float        @default(0)
  receivedAt    DateTime     @default(now())
  deliveredAt   DateTime?
  parts         TicketPart[]
}

model TicketPart {
  id       String            @id @default(cuid())
  ticketId String
  ticket   MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  name     String
  price    Float             @default(0)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  username  String   @default("")
  action    String
  entity    String
  entityId  String   @default("")
  details   String   @default("")
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String @default("")
}

model Notification {
  id          String    @id @default(cuid())
  channel     String    @default("WHATSAPP")
  to          String    @default("")
  template    String    @default("")
  body        String    @default("")
  status      String    @default("PENDING")
  error       String    @default("")
  relatedType String    @default("")
  relatedId   String    @default("")
  createdAt   DateTime  @default(now())
  sentAt      DateTime?
}

model Stocktake {
  id        String          @id @default(cuid())
  no        String          @unique
  branchId  String?
  note      String          @default("")
  status    String          @default("OPEN")
  createdAt DateTime        @default(now())
  closedAt  DateTime?
  items     StocktakeItem[]
}

model StocktakeItem {
  id          String    @id @default(cuid())
  stocktakeId String
  stocktake   Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  systemQty   Float
  countedQty  Float     @default(0)

  @@unique([stocktakeId, productId])
}
