<Application x:Class="Dokkanek.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             StartupUri="UI/MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="UI/Styles/Theme.xaml" />
        <ResourceDictionary Source="UI/Styles/Buttons.xaml" />
        <ResourceDictionary Source="UI/Styles/Cards.xaml" />
        <ResourceDictionary Source="UI/Styles/Tables.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
