<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- mirrors ui.tsx Card rounded-2xl + PageTitle + Stat + Badge -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource CardBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>
  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="8,0,0,0" />
  </Style>
  <Style x:Key="PageSub" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MutedFg}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style x:Key="Badge" TargetType="Border">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="Background" Value="#F1F5F9" />
  </Style>
  <Style x:Key="AccentBar" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BrandBrush}" />
    <Setter Property="Width" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
</ResourceDictionary>
