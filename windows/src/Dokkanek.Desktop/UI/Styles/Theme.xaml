<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="BrandBrush" Color="#0D6EFD" />
  <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
  <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0" />
  <SolidColorBrush x:Key="MutedFg" Color="#64748B" />
  <SolidColorBrush x:Key="SidebarBg" Color="#020617" />
  <SolidColorBrush x:Key="SidebarFg" Color="#94A3B8" />
  <FontFamily x:Key="AppFont">Segoe UI, Tahoma</FontFamily>
  <FontFamily x:Key="DisplayFont">Segoe UI Semibold, Tahoma</FontFamily>
  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="FlowDirection" Value="RightToLeft" />
  </Style>
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="MinHeight" Value="40" />
  </Style>
</ResourceDictionary>
