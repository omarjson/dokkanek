<UserControl x:Class="Dokkanek.Desktop.UI.Views.Stocktake.StocktakeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="4">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
        <Border Style="{{StaticResource AccentBar}}" Height="36" />
        <StackPanel>
          <TextBlock Text="الجرد المخزني" Style="{{StaticResource PageTitle}}" />
          <TextBlock Text="عدّ فعلي ثم اقفل — الفروقات تُسوّى تلقائيا" Style="{{StaticResource PageSub}}" />
        </StackPanel>
      </StackPanel>
      <Border Style="{{StaticResource Card}}">
        <StackPanel>
          <TextBlock Text="بحث" FontWeight="Bold" />
          <TextBox Text="{{Binding SearchText, UpdateSourceTrigger=PropertyChanged}}" MinHeight="40" Margin="0,4,0,8" />
          <DataGrid ItemsSource="{{Binding Items}}" Style="{{StaticResource AppTable}}" MinHeight="220">
            <DataGrid.Columns>
              <DataGridTextColumn Header="الاسم" Binding="{{Binding Name}}" Width="*" />
              <DataGridTextColumn Header="ملاحظات" Binding="{{Binding Note}}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="تحديث" Command="{{Binding RefreshCommand}}" Style="{{StaticResource PrimaryBtn}}" MinHeight="40" />
            <Button Content="جديد" Command="{{Binding RefreshCommand}}" Style="{{StaticResource GhostBtn}}" MinHeight="40" Margin="8,0,0,0" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
